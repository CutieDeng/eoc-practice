#lang racket/base

;; ============================================================
;; gccast generator CLI
;; ============================================================
;;
;;   racket gen/main.rkt --include-dir DIR --version VER \
;;          --rktd OUT.rktd --inc OUT.inc
;;   racket gen/main.rkt --diff DIR-A DIR-B
;;
;; Emits, for one GCC version:
;;   OUT.rktd : Racket-side decode table
;;              ((version "15.2.0")
;;               (include-dir "...")
;;               (codes ((PLUS_EXPR "plus_expr" tcc_binary 2 (#f #f)) ...)))
;;   OUT.inc  : C++ include with the version string and the code
;;              count, consumed by src/gccast.cc
;; ============================================================

(require racket/cmdline racket/pretty racket/port racket/string
         "treedef.rkt")

(define (emit-rktd table version out)
  (define datum
    `((version ,version)
      (include-dir ,(tree-table-include-dir table))
      (codes
       ,(for/list ([c (in-list (tree-table-codes table))])
          (list (tree-code-code c) (tree-code-name c) (tree-code-class c)
                (tree-code-nargs c) (tree-code-operands c))))))
  (call-with-output-file out #:exists 'replace
    (lambda (o)
      (fprintf o ";; generated by gccast-plugin/gen/main.rkt from ~a -- do not edit\n" (tree-table-include-dir table))
      (pretty-write datum o))))

(define (emit-inc table version out)
  (call-with-output-file out #:exists 'replace
    (lambda (o)
      (fprintf o "// generated by gccast-plugin/gen/main.rkt from ~a -- do not edit\n" (tree-table-include-dir table))
      (fprintf o "#define GCCAST_GCC_VERSION \"~a\"\n" version)
      (fprintf o "#define GCCAST_TREE_CODE_COUNT ~a\n" (length (tree-table-codes table)))
      ;; codes the generator knows but which are not base tree.def (front-end
      ;; specific); the walker treats everything generically, this is for
      ;; diagnostics only.
      (fprintf o "#define GCCAST_FRONTEND_CODE_COUNT ~a\n"
               (for/sum ([c (tree-table-codes table)]) (if (equal? (tree-code-source c) "tree.def") 0 1))))))

(module+ main
  (define include-dir #f) (define version #f) (define rktd #f) (define inc #f) (define diff #f)
  (command-line
   #:once-each
   [("--include-dir") d "GCC plugin include dir" (set! include-dir d)]
   [("--version") v "GCC basever, e.g. 15.2.0" (set! version v)]
   [("--rktd") p "output Racket decode table" (set! rktd p)]
   [("--inc") p "output C++ include" (set! inc p)]
   [("--diff") a b "print tree-code differences between two include dirs" (set! diff (list a b))])
  (cond
    [diff
     (define d (diff-tables (harvest (car diff)) (harvest (cadr diff))))
     (printf "only in ~a: ~a\n" (car diff) (hash-ref d 'only-in-a))
     (printf "only in ~a: ~a\n" (cadr diff) (hash-ref d 'only-in-b))
     (printf "changed:\n") (for ([c (hash-ref d 'changed)]) (printf "  ~s\n" c))]
    [else
     (unless (and include-dir version) (error 'gccast-gen "--include-dir and --version are required"))
     (define t (harvest include-dir))
     (when rktd (emit-rktd t version rktd))
     (when inc (emit-inc t version inc))
     (printf "gccast-gen: ~a codes for GCC ~a\n" (length (tree-table-codes t)) version)]))
