#lang racket/base

;; ============================================================
;; gccast frontend: read a gccast-plugin .dat and resolve operands
;; ============================================================
;;
;; - read-gccast-file : path -> TU      (file->value, then shape check)
;; - fn-ref           : Fn TreeId -> Node
;; - check-tu-closed  : TU -> (listof error-string)   every TreeId in range
;; - decode table     : tables/<ver>.rktd generated by gccast-plugin/gen,
;;                      maps GCC tree code -> (name class nargs operand-names)
;; - fn-op            : Fn Node 'FOR_BODY -> Node or #f   operand by accessor name
;; ============================================================

(require racket/file racket/list racket/runtime-path racket/string
         "../../kernel/ir/gccast/types.rkt")

(provide read-gccast-file
         fn-ref
         fn-nodes-of-code
         check-tu-closed
         load-decode-table
         decode-entry
         fn-op
         (struct-out decode))

(define-runtime-path tables-dir "tables")

(define (read-gccast-file path)
  (define v (file->value path))
  (unless (TU? v) (error 'read-gccast-file "~a: expected #s(TU ...), got ~e" path v))
  v)

(define (fn-ref fn ref)
  (cond
    [(not ref) #f]
    [(TreeId? ref) (vector-ref (Fn-nodes fn) (TreeId-id ref))]
    [else (error 'fn-ref "not a TreeId: ~e" ref)]))

;; All nodes of fn whose code is `code` (a symbol like 'for_stmt).
(define (fn-nodes-of-code fn code)
  (for/list ([n (in-vector (Fn-nodes fn))] #:when (eq? (Node-code n) code)) n))

;; Walk every TreeId reachable through fields/type and check bounds.
(define (check-tu-closed tu)
  (define errs '())
  (define (bad! fmt . args) (set! errs (cons (apply format fmt args) errs)))
  (for ([fn (in-list (TU-fns tu))])
    (define n (vector-length (Fn-nodes fn)))
    (define (chk ref where)
      (when (TreeId? ref)
        (unless (< -1 (TreeId-id ref) n)
          (bad! "~a: ~a: TreeId ~a out of range (~a nodes)" (Fn-name fn) where (TreeId-id ref) n))))
    (define (walk v where)
      (cond
        [(TreeId? v) (chk v where)]
        [(pair? v) (walk (car v) where) (walk (cdr v) where)]
        [else (void)]))
    (chk (Fn-decl fn) 'decl)
    (chk (Fn-body fn) 'body)
    (for ([node (in-vector (Fn-nodes fn))] [i (in-naturals)])
      (chk (Node-type node) (list i 'type))
      (walk (Node-fields node) (list i (Node-code node)))))
  (reverse errs))

;; ------------------------------------------------------------
;; Decode tables
;; ------------------------------------------------------------

;; name : string (lowercase GCC name) ; class : symbol ; nargs : integer
;; operands : list of accessor symbols or #f, by position
(struct decode (code name class nargs operands) #:transparent)

;; -> hash: lowercase-name-symbol -> decode
(define (load-decode-table version)
  (define path (build-path tables-dir (string-append version ".rktd")))
  (unless (file-exists? path)
    (error 'load-decode-table "no decode table for GCC ~a (expected ~a); run gccast-plugin/build.rkt" version path))
  (define datum (file->value path))
  (define codes (cadr (assq 'codes datum)))
  (for/hash ([c (in-list codes)])
    (define d (apply decode c))
    (values (string->symbol (decode-name d)) d)))

(define (decode-entry table node)
  (hash-ref table (Node-code node) #f))

;; Operand of `node` named by GCC accessor (e.g. 'FOR_BODY), resolved in fn.
(define (fn-op fn table node accessor)
  (define d (decode-entry table node))
  (unless d (error 'fn-op "unknown tree code ~a" (Node-code node)))
  (define pos (index-of (decode-operands d) accessor))
  (unless pos (error 'fn-op "~a has no operand ~a (operands: ~a)" (Node-code node) accessor (decode-operands d)))
  (define ops (node-ops node))
  (and (< pos (length ops)) (fn-ref fn (list-ref ops pos))))
