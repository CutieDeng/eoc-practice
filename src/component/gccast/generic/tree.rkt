#lang racket/base

;; ============================================================
;; Mutable GENERIC tree for the gccast lowering pipeline
;; ============================================================
;;
;; A faithful re-implementation of GCC's gimplifier needs GCC's
;; in-place tree mutation (`*expr_p = ...`, TREE_SET_CODE, setting
;; TREE_TYPE).  The immutable prefab dump (kernel/ir/gccast) is
;; imported into this working representation by generic/import.rkt
;; and converted back to prefab GIMPLE afterwards.
;;
;; One struct for every node.  `code` is GCC's lowercase tree code
;; name ('plus_expr), `ops` the operand pvector of expression-class
;; nodes, `attrs` a mutable hasheq for everything else (decl/type
;; fields, flags, constant values, STATEMENT_LIST contents ...).
;; Every sequence is a pvector (operands, STATEMENT_LIST statements,
;; BIND_EXPR vars, TYPE_FIELDS, DECL_ARGUMENTS, CONSTRUCTOR elts);
;; in-place operand updates replace the node's pvector.
;; Accessors are named after the GCC macros they stand for.
;;
;; Tree-code classes and operand counts come from the per-GCC-version
;; decode table generated by gccast-plugin (parameter
;; `current-tree-table`).
;;
;; Portions of the logic in this directory follow gcc/tree.cc,
;; gcc/gimple-expr.cc and gcc/gimplify.cc (GPLv3+) function by
;; function; see doc/roadmap.md 6.3 for the licensing note.
;; ============================================================

(require racket/list racket/string racket/match
         "../../../kernel/data/data.rkt"
         "../../../frontend/gccast/reader.rkt")

(provide (struct-out T)
         (struct-out ref)
         current-tree-table current-function-decl current-gcc-version gcc-major-version
         ;; refs (tree* in GCC)
         box-ref op-ref attr-ref ref-get ref-set!
         ;; code tables
         tree-code-class tree-code-length tree-code-name->accessor-pos
         gimple-rhs-class
         ;; construction
         make-tree build0 build1 build2 build3 build4 copy-node
         build-int-cst build-zero-cst build-real-cst build-clobber tree-clobber-p
         build-empty-stmt build-label-expr build-goto
         create-artificial-label create-tmp-var-raw create-tmp-var-name next-tmp-var-id!
         make-ssa-name next-uid! ssa-version-counter tmp-var-id uid-counter
         ;; accessors (GCC macro names, lowercase)
         tree-code set-tree-code! tree-type set-tree-type! tree-loc set-tree-loc!
         tree-operand set-tree-operand! tree-operand-length
         attr set-attr! has-attr?
         tree-side-effects set-tree-side-effects! tree-this-volatile tree-readonly tree-constant
         tree-addressable set-tree-addressable! tree-used set-tree-used! tree-static decl-external
         decl-uid decl-name decl-artificial decl-ignored decl-initial set-decl-initial!
         decl-arguments decl-result decl-context-uid decl-register decl-not-gimple-reg
         decl-seen-in-bind-expr set-decl-seen-in-bind-expr! decl-chain set-decl-chain!
         type-uid type-main-variant type-precision type-unsigned type-mode type-quals
         type-size type-size-unit type-fields type-domain type-arg-types type-min-value type-max-value
         type-canonical-uid type-prototype? type-string-flag
         integer-cst-value real-cst-hex string-cst-bytes
         bind-expr-vars set-bind-expr-vars! bind-expr-body bind-expr-block
         statement-list-stmts set-statement-list-stmts!
         tree-purpose tree-value tree-chain set-tree-chain!
         constructor-elts case-low case-high case-label
         label-expr-label goto-destination decl-expr-decl
         call-expr-fn call-expr-args call-expr-nargs call-expr-arg set-call-expr-arg! call-expr-internal?
         ssa-name-version ssa-name-var
         ;; predicates
         type-p decl-p var-p expr-p constant-class-p comparison-class-p convert-expr-p
         handled-component-p indirect-ref-p
         integral-type-p pointer-type-p aggregate-type-p void-type-p scalar-float-type-p
         boolean-type-p record-or-union-type-p func-or-method-type-p complex-type-p vector-type-p
         integer-zerop integer-onep integer-nonzerop integer-minus-onep
         is-empty-stmt is-empty-type
         useless-type-conversion-p types-compatible-p tree-ssa-useless-type-conversion
         strip-nops strip-useless-type-conversion! strip-type-nops! strip-sign-nops!
         ;; statement lists
         append-to-statement-list! append-to-statement-list-force! expr-first expr-last
         ;; misc
         recalculate-side-effects! truth-value-p
         fold-convert fold-build1 fold-build2 fold-build3 convert-to-ptrofftype
         void-type boolean-type size-type sizetype ptr-type
         set-global-types! tree->datum)

;; ------------------------------------------------------------
;; The node
;; ------------------------------------------------------------

(struct T ([code #:mutable] [type #:mutable] [loc #:mutable] [ops #:mutable] attrs)
  #:property prop:custom-write
  (lambda (t port mode)
    (fprintf port "#<T ~a~a>" (T-code t)
             (cond [(has-attr? t 'uid) (format " uid=~a" (attr t 'uid))]
                   [(has-attr? t 'value) (format " ~a" (attr t 'value))]
                   [else ""]))))

(define (make-tree code #:type [type #f] #:loc [loc #f] #:ops [ops '()] #:attrs [attrs '()])
  (T code type loc (if (pvector? ops) ops (list->pvector ops)) (make-hasheq attrs)))

(define (attr t key [default #f]) (hash-ref (T-attrs t) key default))
(define (set-attr! t key v) (hash-set! (T-attrs t) key v))
(define (has-attr? t key) (hash-has-key? (T-attrs t) key))

(define tree-code T-code)
(define set-tree-code! set-T-code!)
(define tree-type T-type)
(define set-tree-type! set-T-type!)
(define tree-loc T-loc)
(define set-tree-loc! set-T-loc!)

(define (tree-operand t i)
  (define ops (T-ops t))
  (if (< i (pvector-length ops)) (pvector-ref ops i) #f))
(define (set-tree-operand! t i v)
  (define ops
    (let grow ([ops (T-ops t)])
      (if (>= i (pvector-length ops)) (grow (pvector-cons-right ops #f)) ops)))
  (set-T-ops! t (pvector-set ops i v)))
(define (tree-operand-length t)
  ;; VL_EXP: operand 0 is the count (INTEGER_CST) in GCC; in this
  ;; representation we keep the real pvector length.
  (pvector-length (T-ops t)))

;; ------------------------------------------------------------
;; tree* : a settable place
;; ------------------------------------------------------------

(struct ref (getter setter))
(define (ref-get r) ((ref-getter r)))
(define (ref-set! r v) ((ref-setter r) v))
(define (box-ref b) (ref (lambda () (unbox b)) (lambda (v) (set-box! b v))))
(define (op-ref t i) (ref (lambda () (tree-operand t i)) (lambda (v) (set-tree-operand! t i v))))
(define (attr-ref t key) (ref (lambda () (attr t key)) (lambda (v) (set-attr! t key v))))

;; ------------------------------------------------------------
;; Per-version tree code table
;; ------------------------------------------------------------

;; hash: code-symbol -> decode (see frontend/gccast/reader.rkt)
(define current-tree-table (make-parameter #f))
;; "15.2.0" etc.; a few printing details differ between major versions
(define current-gcc-version (make-parameter "15.0.0"))
(define (gcc-major-version)
  (string->number (car (regexp-split #rx"[.]" (current-gcc-version)))))
(define current-function-decl (make-parameter #f))

(define (table-entry code)
  (define tbl (current-tree-table))
  (and tbl (hash-ref tbl code #f)))

(define (tree-code-class code)
  (define d (table-entry code))
  (cond
    [d (decode-class d)]
    ;; nodes we synthesize that may be absent from a table (should not happen)
    [(eq? code 'ssa_name) 'tcc_exceptional]
    [else (error 'tree-code-class "unknown tree code ~a" code)]))

(define (tree-code-length code)
  (define d (table-entry code))
  (if d (decode-nargs d) 0))

;; Position of an accessor (e.g. 'FOR_BODY) among a code's operands.
(define (tree-code-name->accessor-pos code accessor)
  (define d (table-entry code))
  (and d (index-of (decode-operands d) accessor)))

;; gimple_rhs_class_table (gcc/gimple.cc) as a function.
(define (gimple-rhs-class code)
  (case code
    [(truth_and_expr truth_or_expr truth_xor_expr) 'binary]
    [(truth_not_expr) 'unary]
    [(cond_expr widen_mult_plus_expr widen_mult_minus_expr dot_prod_expr sad_expr
      realign_load_expr vec_cond_expr vec_perm_expr bit_insert_expr) 'ternary]
    [(constructor obj_type_ref assert_expr addr_expr with_size_expr ssa_name) 'single]
    [else
     (case (tree-code-class code)
       [(tcc_unary) 'unary]
       [(tcc_binary tcc_comparison) 'binary]
       [(tcc_constant tcc_declaration tcc_reference) 'single]
       [else 'invalid])]))

;; ------------------------------------------------------------
;; Global types (set by import from the function's own nodes)
;; ------------------------------------------------------------

(define void-type (make-parameter #f))
(define boolean-type (make-parameter #f))
(define size-type (make-parameter #f))     ; size_type_node (long unsigned int)
(define sizetype (make-parameter #f))      ; sizetype (bitsizetype's sibling; unsigned)
(define ptr-type (make-parameter #f))      ; ptr_type_node (void *)
(define (set-global-types! #:void v #:boolean b #:size s #:sizetype st #:ptr p)
  (void-type v) (boolean-type b) (size-type s) (sizetype st) (ptr-type p))

;; ------------------------------------------------------------
;; Builders
;; ------------------------------------------------------------

(define uid-counter (make-parameter (box 100000)))
(define (next-uid!) (define b (uid-counter)) (set-box! b (add1 (unbox b))) (unbox b))

;; build0..4 (gcc/tree.cc): statements, MODIFY/INIT/CALL carry
;; TREE_SIDE_EFFECTS unconditionally; other expressions inherit it from
;; their operands (plus TREE_THIS_VOLATILE for references).
(define (build* code type ops)
  (define t (make-tree code #:type type #:ops ops))
  (define cls (tree-code-class code))
  (define se
    (or (eq? cls 'tcc_statement)
        (memq code '(modify_expr init_expr call_expr bind_expr target_expr))
        (for/or ([o (in-list ops)]) (and o (tree-side-effects o)))))
  (set-tree-side-effects! t (and se #t))
  (when (memq code '(integer_cst real_cst string_cst)) (set-attr! t 'constant #t))
  t)
(define (build0 code type) (build* code type '()))
(define (build1 code type a) (build* code type (list a)))
(define (build2 code type a b) (build* code type (list a b)))
(define (build3 code type a b c) (build* code type (list a b c)))
(define (build4 code type a b c d) (build* code type (list a b c d)))
(define (copy-node t)
  (T (T-code t) (T-type t) (T-loc t) (T-ops t) (hash-copy (T-attrs t))))

(define (wrap-int type n)
  ;; sign/zero-extend n to the type's precision (fold_convert_const semantics)
  (define prec (or (type-precision type) 64))
  (define m (bitwise-and n (sub1 (arithmetic-shift 1 prec))))
  (if (and (not (type-unsigned type)) (bitwise-bit-set? m (sub1 prec)))
      (- m (arithmetic-shift 1 prec))
      m))

(define (build-int-cst type n)
  (make-tree 'integer_cst #:type type #:attrs (list (cons 'value (wrap-int type n)) (cons 'constant #t))))
(define (build-zero-cst type)
  (cond
    [(or (integral-type-p type) (pointer-type-p type)) (build-int-cst type 0)]
    [(scalar-float-type-p type) (build-real-cst type 0.0)]
    [else (make-tree 'constructor #:type type #:attrs (list (cons 'elts (pvector-empty)) (cons 'constant #t)))]))
(define (build-real-cst type x)
  (make-tree 'real_cst #:type type #:attrs (list (cons 'real x) (cons 'constant #t))))

;; build_clobber (tree.cc): an empty CONSTRUCTOR marked as clobber
(define (build-clobber type [kind 'storage-end])
  (make-tree 'constructor #:type type
             #:attrs (list (cons 'elts (pvector-empty)) (cons 'clobber kind) (cons 'volatile #t) (cons 'constant #f))))
(define (tree-clobber-p t) (and (eq? (tree-code t) 'constructor) (attr t 'clobber #f) #t))

;; build_empty_stmt: NOP_EXPR of void with integer_zero operand
(define (build-empty-stmt)
  (build1 'nop_expr (void-type) (build-int-cst (size-type) 0)))
(define (build-label-expr label) (build1 'label_expr (void-type) label))
(define (build-goto label) (build1 'goto_expr (void-type) label))

;; create_artificial_label: LABEL_DECL, artificial, ignored, context = current fn
(define (create-artificial-label)
  (make-tree 'label_decl #:type (void-type)
             #:attrs (list (cons 'uid (next-uid!)) (cons 'name #f) (cons 'artificial #t) (cons 'ignored #t)
                           (cons 'context (cons 'function_decl (and (current-function-decl) (decl-uid (current-function-decl))))))))

;; create_tmp_var_name's tmp_var_id_num: translation-unit global.
(define tmp-var-id (make-parameter (box 0)))
(define (next-tmp-var-id!) (define b (tmp-var-id)) (begin0 (unbox b) (set-box! b (add1 (unbox b)))))
;; ASM_FORMAT_PRIVATE_NAME on ELF/Mach-O: "prefix.N" (remove_suffix strips a trailing ".N")
(define (create-tmp-var-name prefix)
  (define p (if prefix (regexp-replace #rx"[.][0-9]+$" prefix "") "T"))
  (format "~a.~a" p (next-tmp-var-id!)))

(define (create-tmp-var-raw type prefix)
  (make-tree 'var_decl #:type type
             #:attrs (list (cons 'uid (next-uid!))
                           (cons 'name (and prefix (create-tmp-var-name prefix)))
                           (cons 'artificial #t) (cons 'ignored #t) (cons 'nameless #t)
                           (cons 'readonly #f) (cons 'external #f) (cons 'static #f) (cons 'used #t)
                           (cons 'addressable #f) (cons 'public #f)
                           (cons 'context (cons 'function_decl (and (current-function-decl) (decl-uid (current-function-decl))))))))

;; SSA names: version counter per function (version 0 is reserved)
(define ssa-version-counter (make-parameter (box 0)))
(define (make-ssa-name type-or-var #:name [name #f])
  (define b (ssa-version-counter))
  (set-box! b (add1 (unbox b)))
  (define type (if (type-p type-or-var) (type-main-variant type-or-var) (tree-type type-or-var)))
  (make-tree 'ssa_name #:type type
             #:attrs (list (cons 'version (unbox b))
                           (cons 'var (if (type-p type-or-var) #f type-or-var))
                           (cons 'identifier name))))

;; ------------------------------------------------------------
;; Flag / field accessors
;; ------------------------------------------------------------

(define (tree-side-effects t) (attr t 'side-effects #f))
(define (set-tree-side-effects! t v) (set-attr! t 'side-effects v))
(define (tree-this-volatile t) (attr t 'volatile #f))
(define (tree-readonly t) (attr t 'readonly #f))
(define (tree-constant t) (attr t 'constant #f))
(define (tree-addressable t) (attr t 'addressable #f))
(define (set-tree-addressable! t v) (set-attr! t 'addressable v))
(define (tree-used t) (attr t 'used #f))
(define (set-tree-used! t v) (set-attr! t 'used v))
(define (tree-static t) (attr t 'static #f))
(define (decl-external t) (attr t 'external #f))
(define (decl-uid t) (attr t 'uid))
(define (decl-name t) (attr t 'name #f))
(define (decl-artificial t) (attr t 'artificial #f))
(define (decl-ignored t) (attr t 'ignored #f))
(define (decl-initial t) (attr t 'initial #f))
(define (set-decl-initial! t v) (set-attr! t 'initial v))
(define (decl-arguments t) (attr t 'arguments (pvector-empty)))
(define (decl-result t) (attr t 'result #f))
(define (decl-context-uid t) (let ([c (attr t 'context #f)]) (and c (cdr c))))
(define (decl-register t) (attr t 'register #f))
(define (decl-not-gimple-reg t) (attr t 'not-gimple-reg #f))
(define (decl-seen-in-bind-expr t) (attr t 'seen-in-bind-expr #f))
(define (set-decl-seen-in-bind-expr! t v) (set-attr! t 'seen-in-bind-expr v))
(define (decl-chain t) (attr t 'chain #f))
(define (set-decl-chain! t v) (set-attr! t 'chain v))

(define (type-uid t) (attr t 'uid))
(define (type-main-variant t) (or (attr t 'main-variant #f) t))
(define (type-precision t) (attr t 'precision #f))
(define (type-unsigned t) (attr t 'unsigned #f))
(define (type-mode t) (attr t 'mode #f))
(define (type-quals t) (attr t 'quals 0))
(define (type-size t) (attr t 'size #f))
(define (type-size-unit t) (attr t 'size-unit #f))
(define (type-fields t) (attr t 'fields (pvector-empty)))
(define (type-domain t) (attr t 'domain #f))
(define (type-arg-types t) (attr t 'arg-types #f))
(define (type-min-value t) (attr t 'min #f))
(define (type-max-value t) (attr t 'max #f))
(define (type-canonical-uid t) (attr t 'canonical-uid #f))
(define (type-prototype? t) (attr t 'prototype #f))
(define (type-string-flag t) (attr t 'string-flag #f))

(define (integer-cst-value t) (attr t 'value))
(define (real-cst-hex t) (attr t 'hex #f))
(define (string-cst-bytes t) (attr t 'bytes))

;; BIND_EXPR: operands (vars body block); vars kept as a list in attrs
(define (bind-expr-vars t) (attr t 'vars (pvector-empty)))
(define (set-bind-expr-vars! t vs) (set-attr! t 'vars vs))
(define (bind-expr-body t) (tree-operand t 1))
(define (bind-expr-block t) (tree-operand t 2))

(define (statement-list-stmts t) (attr t 'stmts (pvector-empty)))
(define (set-statement-list-stmts! t l) (set-attr! t 'stmts l))

(define (tree-purpose t) (attr t 'purpose #f))
(define (tree-value t) (attr t 'value #f))
(define (tree-chain t) (attr t 'chain #f))
(define (set-tree-chain! t v) (set-attr! t 'chain v))

(define (constructor-elts t) (attr t 'elts (pvector-empty)))
(define (case-low t) (tree-operand t 0))
(define (case-high t) (tree-operand t 1))
(define (case-label t) (tree-operand t 2))
(define (label-expr-label t) (tree-operand t 0))
(define (goto-destination t) (tree-operand t 0))
(define (decl-expr-decl t) (tree-operand t 0))

;; CALL_EXPR operands: 0 = nargs (INTEGER_CST), 1 = fn, 2 = static chain, 3.. = args
(define (call-expr-fn t) (tree-operand t 1))
(define (call-expr-nargs t) (max 0 (- (tree-operand-length t) 3)))
(define (call-expr-arg t i) (tree-operand t (+ 3 i)))
(define (set-call-expr-arg! t i v) (set-tree-operand! t (+ 3 i) v))
(define (call-expr-args t) (for/pvector ([i (in-range (call-expr-nargs t))]) (call-expr-arg t i)))
(define (call-expr-internal? t) (attr t 'internal #f))

(define (ssa-name-version t) (attr t 'version))
(define (ssa-name-var t) (attr t 'var #f))

;; ------------------------------------------------------------
;; Predicates
;; ------------------------------------------------------------

(define (type-p t) (and t (eq? (tree-code-class (tree-code t)) 'tcc_type)))
(define (decl-p t) (and t (eq? (tree-code-class (tree-code t)) 'tcc_declaration)))
(define (var-p t) (and t (eq? (tree-code t) 'var_decl)))
(define (expr-p t)
  (and t (memq (tree-code-class (tree-code t))
               '(tcc_expression tcc_unary tcc_binary tcc_comparison tcc_reference tcc_statement tcc_vl_exp))
       #t))
(define (constant-class-p t) (and t (eq? (tree-code-class (tree-code t)) 'tcc_constant)))
(define (comparison-class-p t) (and t (eq? (tree-code-class (tree-code t)) 'tcc_comparison)))
(define (convert-expr-p t) (and t (memq (tree-code t) '(nop_expr convert_expr)) #t))
(define (handled-component-p t)
  (and t (memq (tree-code t) '(component_ref bit_field_ref array_ref array_range_ref realpart_expr imagpart_expr view_convert_expr)) #t))
(define (indirect-ref-p t) (and t (eq? (tree-code t) 'indirect_ref)))

(define (integral-type-p t) (and t (memq (tree-code t) '(enumeral_type boolean_type integer_type bitint_type)) #t))
(define (pointer-type-p t) (and t (memq (tree-code t) '(pointer_type reference_type)) #t))
(define (aggregate-type-p t) (and t (memq (tree-code t) '(array_type record_type union_type qual_union_type)) #t))
(define (void-type-p t) (and t (eq? (tree-code t) 'void_type)))
(define (scalar-float-type-p t) (and t (eq? (tree-code t) 'real_type)))
(define (boolean-type-p t) (and t (eq? (tree-code t) 'boolean_type)))
(define (record-or-union-type-p t) (and t (memq (tree-code t) '(record_type union_type qual_union_type)) #t))
(define (func-or-method-type-p t) (and t (memq (tree-code t) '(function_type method_type)) #t))
(define (complex-type-p t) (and t (eq? (tree-code t) 'complex_type)))
(define (vector-type-p t) (and t (eq? (tree-code t) 'vector_type)))

(define (integer-zerop t) (and t (eq? (tree-code t) 'integer_cst) (eqv? (integer-cst-value t) 0)))
(define (integer-onep t) (and t (eq? (tree-code t) 'integer_cst) (eqv? (integer-cst-value t) 1)))
(define (integer-nonzerop t) (and t (eq? (tree-code t) 'integer_cst) (not (eqv? (integer-cst-value t) 0))))
(define (integer-minus-onep t) (and t (eq? (tree-code t) 'integer_cst) (eqv? (integer-cst-value t) -1)))

;; IS_EMPTY_STMT: NOP_EXPR of void type whose operand is integer zero
(define (is-empty-stmt t)
  (and t (eq? (tree-code t) 'nop_expr) (void-type-p (tree-type t)) (integer-zerop (tree-operand t 0))))

(define (is-empty-type type)
  (cond
    [(record-or-union-type-p type)
     (for/and ([f (type-fields type)])
       (or (not (eq? (tree-code f) 'field_decl)) (attr f 'padding #f) (is-empty-type (tree-type f))))]
    [(eq? (tree-code type) 'array_type)
     (define dom (type-domain type))
     (or (not dom)
         (let ([mx (type-max-value dom)] [mn (type-min-value dom)])
           (and mx mn (eq? (tree-code mx) 'integer_cst) (eq? (tree-code mn) 'integer_cst)
                (< (integer-cst-value mx) (integer-cst-value mn))))
         (is-empty-type (tree-type type)))]
    [else #f]))

(define (truth-value-p code)
  (and (memq code '(truth_and_expr truth_or_expr truth_xor_expr truth_andif_expr truth_orif_expr truth_not_expr)) #t))

;; useless_type_conversion_p (gcc/gimple-expr.cc), C subset
(define (useless-type-conversion-p outer inner)
  (let/ec return
    (when (and (pointer-type-p inner) (pointer-type-p outer))
      (when (and (func-or-method-type-p (tree-type outer)) (not (func-or-method-type-p (tree-type inner))))
        (return #f)))
    (define in (type-main-variant inner))
    (define out (type-main-variant outer))
    (when (eq? in out) (return #t))
    (unless (equal? (type-mode in) (type-mode out)) (return #f))
    (cond
      [(and (integral-type-p in) (integral-type-p out))
       (when (or (not (eq? (type-unsigned in) (type-unsigned out)))
                 (not (eqv? (type-precision in) (type-precision out))))
         (return #f))
       (when (and (not (eq? (boolean-type-p in) (boolean-type-p out)))
                  (not (eqv? (type-precision out) 1)))
         (return #f))
       (when (not (eq? (eq? (tree-code in) 'bitint_type) (eq? (tree-code out) 'bitint_type)))
         (return #f))
       #t]
      [(and (scalar-float-type-p in) (scalar-float-type-p out)) #t]
      [(and (pointer-type-p in) (pointer-type-p out)) #t]
      [(and (complex-type-p in) (complex-type-p out))
       (useless-type-conversion-p (tree-type out) (tree-type in))]
      [(and (eq? (tree-code in) 'array_type) (eq? (tree-code out) 'array_type))
       (when (not (eq? (type-string-flag in) (type-string-flag out))) (return #f))
       (when (and (not (type-domain in)) (type-domain out)) (return #f))
       (define os (type-size out)) (define is (type-size in))
       (when (and os (eq? (tree-code os) 'integer_cst)
                  (or (not is) (not (eq? (tree-code is) 'integer_cst))
                      (not (eqv? (integer-cst-value os) (integer-cst-value is)))))
         (return #f))
       (when (and (type-domain in) (type-domain out) (not (eq? (type-domain in) (type-domain out))))
         (define (cst v) (and v (eq? (tree-code v) 'integer_cst) v))
         (define imin (cst (type-min-value (type-domain in)))) (define omin (cst (type-min-value (type-domain out))))
         (define imax (cst (type-max-value (type-domain in)))) (define omax (cst (type-max-value (type-domain out))))
         (when (and omin (or (not imin) (not (eqv? (integer-cst-value imin) (integer-cst-value omin))))) (return #f))
         (when (and omax (or (not imax) (not (eqv? (integer-cst-value imax) (integer-cst-value omax))))) (return #f)))
       (useless-type-conversion-p (tree-type out) (tree-type in))]
      [(and (func-or-method-type-p in) (eq? (tree-code in) (tree-code out)))
       (unless (useless-type-conversion-p (tree-type out) (tree-type in)) (return #f))
       (unless (type-prototype? out) (return #t))
       (when (eq? (type-arg-types out) (type-arg-types in)) (return #t))
       (let loop ([op (type-arg-types out)] [ip (type-arg-types in)])
         (cond
           [(and op ip)
            (unless (useless-type-conversion-p (type-main-variant (tree-value op)) (type-main-variant (tree-value ip)))
              (return #f))
            (loop (tree-chain op) (tree-chain ip))]
           [(or op ip) #f]
           [else #t]))]
      [(and (aggregate-type-p in) (eq? (tree-code in) (tree-code out)))
       (and (type-canonical-uid in) (eqv? (type-canonical-uid in) (type-canonical-uid out)))]
      [else #f])))

(define (types-compatible-p a b)
  (or (eq? a b) (and (useless-type-conversion-p a b) (useless-type-conversion-p b a))))

(define (tree-ssa-useless-type-conversion expr)
  (and (or (convert-expr-p expr) (memq (tree-code expr) '(view_convert_expr non_lvalue_expr)))
       (useless-type-conversion-p (tree-type expr) (tree-type (tree-operand expr 0)))))

;; STRIP_USELESS_TYPE_CONVERSION on a ref (tree*)
(define (strip-useless-type-conversion! r)
  (let loop ()
    (define e (ref-get r))
    (when (and e (tree-ssa-useless-type-conversion e))
      (ref-set! r (tree-operand e 0))
      (loop))))
;; STRIP_NOPS-like: strip conversions that do not change mode/precision; here: nop/convert with same mode
(define (strip-nops e)
  (let loop ([e e])
    (if (and e (or (convert-expr-p e) (eq? (tree-code e) 'non_lvalue_expr))
             (equal? (type-mode (tree-type e)) (type-mode (tree-type (tree-operand e 0)))))
        (loop (tree-operand e 0))
        e)))
(define (strip-type-nops! r)
  ;; STRIP_TYPE_NOPS: strip NOP/CONVERT/NON_LVALUE whose operand has the same type
  (let loop ()
    (define e (ref-get r))
    (when (and e (or (convert-expr-p e) (eq? (tree-code e) 'non_lvalue_expr))
               (tree-operand e 0) (eq? (tree-type (tree-operand e 0)) (tree-type e)))
      (ref-set! r (tree-operand e 0)) (loop))))
(define (strip-sign-nops! r)
  ;; STRIP_SIGN_NOPS: like STRIP_NOPS but keep sign/precision-changing conversions
  (let loop ()
    (define e (ref-get r))
    (when (and e (or (convert-expr-p e) (eq? (tree-code e) 'non_lvalue_expr)))
      (define o (tree-operand e 0))
      (define ot (tree-type o)) (define et (tree-type e))
      (when (and o (equal? (type-mode ot) (type-mode et))
                 (eq? (type-unsigned ot) (type-unsigned et))
                 (eqv? (type-precision ot) (type-precision et))
                 (eq? (pointer-type-p ot) (pointer-type-p et)))
        (ref-set! r o) (loop)))))

;; ------------------------------------------------------------
;; Statement lists (gcc/tree-iterator.cc)
;; ------------------------------------------------------------

(define (expr-first e)
  (cond [(not e) #f]
        [(eq? (tree-code e) 'statement_list)
         (define l (statement-list-stmts e))
         (if (pvector-empty? l) #f (expr-first (pvector-ref l 0)))]
        [else e]))
(define (expr-last e)
  (cond [(not e) #f]
        [(eq? (tree-code e) 'statement_list)
         (define l (statement-list-stmts e))
         (if (pvector-empty? l) #f (expr-last (pvector-last l)))]
        [else e]))

(define (make-statement-list) (make-tree 'statement_list #:type (void-type) #:attrs (list (cons 'stmts (pvector-empty)) (cons 'side-effects #t))))

;; append_to_statement_list_1
(define (append-to-statement-list-1! t r)
  (define lst (ref-get r))
  (cond
    [(not lst)
     (cond
       [(and t (eq? (tree-code t) 'statement_list))
        (ref-set! r t)]
       [else
        (define sl (make-statement-list))
        (set-statement-list-stmts! sl (pvector t))
        (ref-set! r sl)])]
    [(eq? (tree-code lst) 'statement_list)
     (set-statement-list-stmts! lst (pvector-cons-right (statement-list-stmts lst) t))]
    [else
     (define sl (make-statement-list))
     (set-statement-list-stmts! sl (pvector lst t))
     (ref-set! r sl)]))

;; append_to_statement_list: skip statements without side effects
(define (append-to-statement-list! t r)
  (when (and t (tree-side-effects t))
    (append-to-statement-list-1! t r)))
(define (append-to-statement-list-force! t r)
  (when t (append-to-statement-list-1! t r)))

;; ------------------------------------------------------------
;; Side effects (gcc/gimplify.cc recalculate_side_effects)
;; ------------------------------------------------------------

(define (recalculate-side-effects! t)
  (define code (tree-code t))
  (define cls (tree-code-class code))
  (case cls
    [(tcc_expression)
     (case code
       [(init_expr modify_expr va_arg_expr bind_expr compound_expr cond_expr truth_andif_expr truth_orif_expr
         call_expr loop_expr exit_expr switch_expr label_expr goto_expr return_expr
         predict_expr try_finally_expr try_catch_expr cleanup_point_expr target_expr with_cleanup_expr)
        ;; Statements and side-effecting expressions keep their flag.
        (void)]
       [else (recompute-from-operands! t)])]
    [(tcc_comparison tcc_unary tcc_binary tcc_reference tcc_vl_exp)
     (recompute-from-operands! t)]
    [else (void)]))

(define (recompute-from-operands! t)
  (define se
    (or (and (eq? (tree-code-class (tree-code t)) 'tcc_reference) (tree-this-volatile t))
        (and (eq? (tree-code t) 'call_expr) #t)
        (for/or ([o (in-pvector (T-ops t))]) (and o (tree-side-effects o)))))
  (set-tree-side-effects! t (and se #t)))

;; ------------------------------------------------------------
;; A small fold (the subset gimplification relies on at -O0)
;; ------------------------------------------------------------

;; fold_convert: no-op if useless; constant-fold INTEGER_CST; else NOP_EXPR
(define (fold-convert type e)
  (cond
    [(or (eq? type (tree-type e)) (useless-type-conversion-p type (tree-type e))) e]
    [(and (eq? (tree-code e) 'integer_cst) (or (integral-type-p type) (pointer-type-p type)))
     (build-int-cst type (integer-cst-value e))]
    [(and (eq? (tree-code e) 'integer_cst) (scalar-float-type-p type))
     (build-real-cst type (exact->inexact (integer-cst-value e)))]
    [(and (eq? (tree-code e) 'real_cst) (attr e 'real) (integral-type-p type))
     (build-int-cst type (inexact->exact (truncate (attr e 'real))))]
    [(aggregate-type-p type) (build1 'view_convert_expr type e)]
    [else
     (define n (build1 'nop_expr type e))
     (recalculate-side-effects! n)
     n]))

(define (fold-build1 code type a)
  (define t (build1 code type a))
  (cond
    [(and (eq? code 'negate_expr) (eq? (tree-code a) 'integer_cst))
     (build-int-cst type (- (integer-cst-value a)))]
    [(and (eq? code 'negate_expr) (eq? (tree-code a) 'negate_expr)) (tree-operand a 0)]
    [(memq code '(nop_expr convert_expr)) (fold-convert type a)]
    [else (recalculate-side-effects! t) t]))

(define (fold-build2 code type a b)
  (define (icst? x) (eq? (tree-code x) 'integer_cst))
  (define (ret t) (recalculate-side-effects! t) t)
  (cond
    ;; constant folding of integer arithmetic / comparison
    [(and (icst? a) (icst? b) (memq code '(plus_expr minus_expr mult_expr bit_and_expr bit_ior_expr bit_xor_expr pointer_plus_expr)))
     (define x (integer-cst-value a)) (define y (integer-cst-value b))
     (build-int-cst type (case code [(plus_expr pointer_plus_expr) (+ x y)] [(minus_expr) (- x y)] [(mult_expr) (* x y)]
                           [(bit_and_expr) (bitwise-and x y)] [(bit_ior_expr) (bitwise-ior x y)] [(bit_xor_expr) (bitwise-xor x y)]))]
    [(and (icst? a) (icst? b) (memq code '(lt_expr le_expr gt_expr ge_expr eq_expr ne_expr)))
     (define x (integer-cst-value a)) (define y (integer-cst-value b))
     (build-int-cst type (if (case code [(lt_expr) (< x y)] [(le_expr) (<= x y)] [(gt_expr) (> x y)] [(ge_expr) (>= x y)] [(eq_expr) (= x y)] [(ne_expr) (not (= x y))]) 1 0))]
    ;; A - C -> A + (-C)   (fold-const.cc, MINUS_EXPR with negatable constant)
    [(and (eq? code 'minus_expr) (icst? b) (integral-type-p type))
     (ret (build2 'plus_expr type a (build-int-cst type (- (integer-cst-value b)))))]
    ;; x + 0, x * 1
    [(and (eq? code 'plus_expr) (integer-zerop b)) (fold-convert type a)]
    [(and (eq? code 'mult_expr) (integer-onep b)) (fold-convert type a)]
    [else (ret (build2 code type a b))]))

(define (fold-build3 code type a b c)
  (define t (build3 code type a b c))
  (recalculate-side-effects! t)
  t)

;; convert_to_ptrofftype: convert to sizetype
(define (convert-to-ptrofftype e) (fold-convert (sizetype) e))

;; ------------------------------------------------------------
;; Debug printing
;; ------------------------------------------------------------

(define (tree->datum t [depth 3])
  (cond
    [(not t) #f]
    [(zero? depth) (format "~a" t)]
    [else
     (list* (tree-code t)
            (for/list ([o (in-pvector (T-ops t))]) (tree->datum o (sub1 depth))))]))
